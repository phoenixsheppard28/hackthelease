AGENTMAIL_TEST_RECIPIENT=
# Supabase Auth user IDs allowed to review and publish availability confirmations.
AVAILABILITY_REVIEWER_USER_IDS=

# Travel estimates
GOOGLE_MAPS_API_KEY=

# Public HTTPS origin for Firecrawl callbacks and Google sign-in
APP_BASE_URL=
