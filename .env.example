# Supabase project settings
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=

# Comma-separated Supabase Auth user IDs that may start a refresh
REFRESH_ALLOWED_USER_IDS=

# Firecrawl ingestion
FIRECRAWL_API_KEY=
FIRECRAWL_WEBHOOK_SECRET=

# Listing and preference embeddings
OPENAI_API_KEY=

# Group availability email (server-only)
AGENTMAIL_API_KEY=
AGENTMAIL_WEBHOOK_SECRET=
